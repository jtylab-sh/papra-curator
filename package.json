{
  "name": "papra-curator",
  "version": "0.1.0",
  "private": true,
  "description": "Tagging, renaming and downstream handlers for Papra",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'src/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "pretest": "prisma generate --no-hints"
  },
  "//": "The service depends on Prisma at runtime and needs `prisma generate` before it runs. eslint, prettier and typescript are dev-only and never reach the image.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0",
    "smol-toml": "^1.8.0"
  }
}
